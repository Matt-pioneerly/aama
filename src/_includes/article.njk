{% extends "base.njk" %}

{% block content %}
<section class="article-hero">
  <div class="container">
    <div class="article-hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span>
        <a href="/library">Library</a><span>/</span>
        <span class="breadcrumb-current">{{ breadcrumbLabel or title }}</span>
      </nav>
      <div class="article-category">{{ category }}</div>
      <h1>{{ title }}</h1>
      <div class="article-meta">
        <div class="article-author">
          <div class="author-avatar">{{ author[0] }}</div>
          <div class="author-info">
            <span class="author-name">{{ author }}</span>
            <span class="author-role">American Attorney Marketing Association</span>
          </div>
        </div>
        <div class="meta-divider"></div>
        <span class="meta-item">{{ date | postDate }}</span>
        <div class="meta-divider"></div>
        <span class="meta-item">{{ readTime }} min read</span>
      </div>
    </div>
  </div>
</section>

<div class="article-layout">
  <article class="article-body">
    {{ content | safe }}
  </article>

  <aside class="article-sidebar">
    <div class="sidebar-card" id="toc-card" style="display:none;">
      <h4>In This Article</h4>
      <ul class="toc-list" id="toc-list"></ul>
    </div>
    <div class="sidebar-cta">
      <h4>Join the AAMA Community</h4>
      <p>Connect with attorneys building more systematic, effective practices.</p>
      <a href="/#contact">Apply for Membership</a>
    </div>
  </aside>
</div>

<script>
  (function() {
    const headings = document.querySelectorAll('.article-body h2[id], .article-body h3[id]');
    const tocList = document.getElementById('toc-list');
    const tocCard = document.getElementById('toc-card');

    if (headings.length < 2) return;

    headings.forEach(function(heading) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      const dot = document.createElement('span');
      dot.className = 'toc-dot';
      a.href = '#' + heading.id;
      a.appendChild(dot);
      a.appendChild(document.createTextNode(' ' + heading.textContent));
      if (heading.tagName === 'H3') {
        a.style.paddingLeft = '1.25rem';
        a.style.fontSize = '0.875rem';
      }
      li.appendChild(a);
      tocList.appendChild(li);
    });

    tocCard.style.display = 'block';
  })();
</script>
{% endblock %}
