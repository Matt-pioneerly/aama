{
  "buildCommand": "npm run build",
  "outputDirectory": "_site",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/admin/config.yml",
      "headers": [
        { "key": "Content-Type", "value": "text/yaml" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "redirects": [
    { "source": "/admin", "destination": "/admin/", "permanent": false },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/library.html", "destination": "/library", "permanent": true },
    { "source": "/top-7-legal-marketing-agencies.html", "destination": "/top-7-legal-marketing-agencies", "permanent": true },
    { "source": "/navigating-bar-rules-ai-content.html", "destination": "/navigating-bar-rules-ai-content", "permanent": true },
    { "source": "/local-search-2025-solo-attorneys.html", "destination": "/local-search-2025-solo-attorneys", "permanent": true },
    { "source": "/ai-intake-tools-law-firms.html", "destination": "/ai-intake-tools-law-firms", "permanent": true },
    { "source": "/referral-network-attorneys-overlook.html", "destination": "/referral-network-attorneys-overlook", "permanent": true },
    { "source": "/solo-practitioner-doubled-consultations.html", "destination": "/solo-practitioner-doubled-consultations", "permanent": true }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" }
  ]
}
